# Copy this file to backend/.env and fill in values.
# backend/.env is git-ignored: NEVER commit real credentials or .env files.

APP_NAME="Resume Sync Platform"
ENVIRONMENT=development

# --- Database ---
# Local prototype defaults to SQLite. Later, switch to PostgreSQL by changing
# only this URL (no schema changes expected):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/resume_sync
DATABASE_URL=sqlite+pysqlite:///./data/resume_sync.db

# --- CORS ---
# Comma-separated list of allowed browser origins (Vite dev server defaults).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Integration credentials (optional, planned features) ---
# GitHub: create a fine-grained, read-only personal access token for public data.
GITHUB_TOKEN=
# LeetCode: public GraphQL endpoint needs no token today; reserved for later.
LEETCODE_API_BASE_URL=https://leetcode.com/api/graphql/
# LinkedIn: official API via OAuth only. Scraping/session cookies violate
# LinkedIn policy and must not be used.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
